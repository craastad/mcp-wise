# Wise API token (required)
WISE_API_TOKEN=your_wise_api_token_here

# Use Wise Sandbox API (true/false)
WISE_IS_SANDBOX=false

# Default profile id for every tool; run list_profiles to see the ids (optional)
# WISE_PROFILE_ID=12345678

# RSA private key whose public key is uploaded to Wise, for Strong Customer Authentication (optional)
# WISE_PRIVATE_KEY_PATH=/path/to/private.pem
# WISE_PRIVATE_KEY_PASSPHRASE=

# MCP Server transport mode (http/stdio)
MODE=stdio
